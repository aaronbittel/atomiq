<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/static/css/main.css">
    <title>Atomiq</title>
</head>
<body>
    <div class="workspace">
        {{range .Columns}}
        <div class="column">
            <h2>{{.Name}}</h2>
            {{range .WorkItems}}
            <div class="work-item">
                <p>{{.}}</p>
            </div>
            {{end}}
        </div>
        {{end}}
    </div>
</body>
</html>
